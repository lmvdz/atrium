{
  "name": "@atrium/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Atrium server — WebSocket realtime + pg-boss interpretation workers.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@atrium/core": "workspace:*",
    "@atrium/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg-boss": "^12.26.3",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
