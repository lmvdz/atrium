{
  "name": "@atrium/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Atrium web — Conversation / Current state / Needs you.",
  "scripts": {
    "dev": "next dev --port ${WEB_PORT:-3000}",
    "build": "next build",
    "start": "next start --port ${WEB_PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:mutations": "node test/mutations.mjs",
    "test:e2e": "node e2e/support/ensure-database.mjs && playwright test",
    "test:e2e:destination": "playwright install chromium && node e2e/support/ensure-database.mjs && playwright test --config playwright.destination.config.ts",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@atrium/auth": "workspace:*",
    "@atrium/core": "workspace:*",
    "@atrium/db": "workspace:*",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.12",
    "prism-react-renderer": "2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "postgres": "^3.4.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
