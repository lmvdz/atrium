{
  "name": "atrium",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter \"./packages/*\" build && pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "ingest": "pnpm --filter @atrium/ingest... build && node packages/ingest/dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @atrium/web test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm --filter \"./packages/*\" build && pnpm -r typecheck",
    "db:generate": "pnpm --filter @atrium/db generate",
    "db:migrate": "pnpm --filter @atrium/db migrate",
    "infra:up": "docker compose up -d postgres minio",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
