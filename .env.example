# Copy to .env and adjust. Every service in docker-compose.yml reads from this
# file, and compose will not start without it — the secrets below have no
# defaults there on purpose.
#
# `pnpm infra:up` + `pnpm dev` works with these values unchanged ON A LAPTOP.
#
# POSTGRES_PASSWORD, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY below are
# DEVELOPMENT CREDENTIALS, committed to a public repository. Never deploy with
# them. On anything reachable from the internet, replace all three, and note
# that apps/server runs NODE_ENV=production there — it requires the two S3
# values explicitly rather than falling back to these.
#
# NODE_ENV=development below is what turns the fallback ON. It is an opt-in:
# an unset NODE_ENV is treated as production and the fallback does not apply.
# Values are trimmed before validation, so a stray newline is harmless and a
# whitespace-only value fails as empty.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=atrium
POSTGRES_PASSWORD=atrium
POSTGRES_DB=atrium
POSTGRES_PORT=5432

# Used by packages/db (drizzle-kit + runtime client) and apps/server (pg-boss).
# Inside compose the host is `postgres`; from the host machine it is `localhost`.
DATABASE_URL=postgres://atrium:atrium@localhost:5432/atrium

# ── Atrium server (WebSocket + pg-boss workers) ─────────────────────────────
SERVER_PORT=4000
SERVER_HOST=0.0.0.0
# Milliseconds between server->client WebSocket pings. Sockets that miss two
# consecutive pongs are terminated.
WS_HEARTBEAT_INTERVAL_MS=30000
# How long an open socket's session is trusted between re-validations. This is
# the window in which a revoked session still has authority: 0 re-checks on
# every command, 60000 is the ceiling.
WS_REVALIDATE_TTL_MS=5000
# How often EVERY open socket is swept — session re-checked, room memberships
# re-checked — whether or not it has sent anything. A socket that only listens
# sends no commands, so this is what bounds how long a removed member goes on
# receiving a room's broadcasts. 1000..300000; there is deliberately no "off".
WS_SWEEP_INTERVAL_MS=15000
# What happens when the sweep cannot get an answer. A lookup that throws is not
# "you were removed", so it is tolerated — but only this many consecutive sweeps
# or this long, whichever comes first, and then the socket is closed and may
# reconnect. Unbounded tolerance means a revoked member keeps receiving for as
# long as the database stays down.
WS_SWEEP_FAILURE_LIMIT=3
WS_SWEEP_UNVERIFIED_MS=60000
# May a client that sends no Origin header open a socket? Browsers always send
# one, so `false` is right for a browser-facing deployment. Set it only for a
# deployment with genuine non-browser clients.
WS_ALLOW_ORIGINLESS=false
# Concurrency for the interpret-message worker.
INTERPRET_WORKER_CONCURRENCY=2
LOG_LEVEL=info
NODE_ENV=development

# What is in front of these processes, for the rate limiter's IP dimension.
# REQUIRED IN PRODUCTION — both apps/server and apps/web refuse to run without
# it, and refuse a value they cannot parse (`lots`, `-3`, `1.5`): a value nobody
# can act on is not a configuration, it is the unset case wearing a number.
#   0 = nothing in front; the socket's peer address is the caller.
#   N = N reverse proxies that append to X-Forwarded-For; the caller is the Nth
#       entry counted from the RIGHT. `1` for one nginx/Caddy.
# docker-compose.yml ships a Caddy in front of both processes and uses 1, because
# `0` on the Next.js side means NO address at all — Next cannot hand a Server
# Action the socket's peer, and the header there is unfalsifiable. Under `0` an
# unresolvable caller is counted against ONE SHARED BUCKET rather than skipped
# (that was round 3's fail-open); a per-address limit needs a proxy in front.
ATRIUM_TRUSTED_PROXY_HOPS=1

# Optional: which addresses in the X-Forwarded-For chain are our own proxies,
# comma separated, by address or CIDR. Handed to Better Auth as
# `advanced.ipAddress.trustedProxies` too, so its limiter and Atrium's walk the
# chain by the same rule — right to left until the first hop that is not one of
# these — instead of hop-counting on one side and "trust a single-value header"
# on the other. Unparseable entries are ignored, like Better Auth ignores them.
# Leave blank when your proxies have no fixed address; the hop count still holds.
ATRIUM_TRUSTED_PROXY_CIDRS=172.28.0.10/32

# ── Web (Next.js) ───────────────────────────────────────────────────────────
# The hostname the production compose stack serves. REQUIRED BY COMPOSE — it is
# left blank here on purpose, and `${ATRIUM_DOMAIN:?...}` makes compose refuse
# to start until somebody answers. Caddy takes it as its site address and gets
# a certificate for it over ACME; APP_URL and NEXT_PUBLIC_WS_URL are derived
# from it inside docker-compose.yml as https:// and wss:// and are not settable
# there. Set it to `localhost` if you are using the development override
# (docker-compose.dev.yml), which serves plaintext and ignores the value.
ATRIUM_DOMAIN=
# The proxy's published ports in the production stack. 443 serves the site; 80
# answers the ACME challenge and redirects. Only these two face the internet.
HTTPS_PORT=443
HTTP_PORT=80
# The single published port of the *development* override only. `app` and
# `server` are never published in either stack, because a second way in would
# make ATRIUM_TRUSTED_PROXY_HOPS a claim that is false for anyone who used it.
WEB_PORT=3000
# ── The realtime socket URL (issue #22) ─────────────────────────────────────
# THE `NEXT_PUBLIC_WS_URL` THAT USED TO BE HERE IS GONE ON PURPOSE. Read the
# realtime lane's note below: a NEXT_PUBLIC_ variable is inlined into the
# client bundle at BUILD time, so one image could not be promoted between
# environments and an https:// deployment shipped a `ws://localhost` bundle
# that browsers refuse as mixed content. The two variables that replace it are
# read at RUNTIME. The auth lane's paragraph about cleartext still applies to
# them, and to APP_URL, word for word: both processes REFUSE TO START under
# NODE_ENV=production with an http:// or ws:// value, because those are the
# origins session cookies are minted for and the origin the browser opens a
# socket against. There is no override — see packages/auth/src/transport.ts.
# The WebSocket endpoint, read AT RUNTIME by /api/runtime-config — not inlined
# into the client bundle. (It replaces NEXT_PUBLIC_WS_URL, which was: one image
# could not be promoted between environments, and an https:// page shipped a
# ws://localhost bundle that browsers refuse as mixed content.)
#
# In dev it must be set, because Next is on 3000 and the server on 4000 — not
# the same origin. In production behind a reverse proxy that forwards /ws to
# the app server, LEAVE IT UNSET: the browser derives the URL from the page's
# own origin, and wss: follows https: with nothing to get wrong.
ATRIUM_WS_URL=ws://localhost:4000/ws
# Same-origin path used when ATRIUM_WS_URL is unset. Only change this if the
# proxy forwards the socket somewhere other than /ws.
ATRIUM_WS_PATH=/ws

# Public origin of the web app. Better Auth derives cookie names and the secure
# flag from it, and both the web app and the realtime server must agree.
APP_URL=http://localhost:3000

# ── Auth (Better Auth, issue #13) ───────────────────────────────────────────
# Signs session cookies and hashes verification tokens. The web app and the
# realtime server MUST share the same value or every WebSocket upgrade reads as
# unauthenticated. Generate one with `openssl rand -base64 32`.
# Required in production; development falls back to a well-known dev secret.
BETTER_AUTH_SECRET=

# One OAuth provider, optional. Leave blank and the button is not rendered.
# Callback URL: ${APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Dev mailer: there is no SMTP transport yet. Verification and invitation links
# are printed to the server console. Set this to also append them to a file, one
# JSON object per line — the e2e suite reads it. Ignored when NODE_ENV=production.
ATRIUM_MAIL_OUTBOX=

# ── Object storage (MinIO in dev, any S3-compatible bucket in prod) ─────────
S3_ENDPOINT=http://localhost:9000
# Browser-reachable S3/MinIO origin used in presigned URLs. In the full compose
# stack this is the same public Atrium origin and Caddy routes /bucket/key.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=atrium-attachments
S3_ACCESS_KEY_ID=atrium
S3_SECRET_ACCESS_KEY=atrium-dev-secret
S3_FORCE_PATH_STYLE=true
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Model access (Vercel AI SDK + AI Gateway, per issue #7) ─────────────────
# The credential the AI SDK reads for itself. Nothing in apps/server ever holds
# it, so nothing can log it.
AI_GATEWAY_API_KEY=

# ── The interpretation worker (issues #8, #23) ──────────────────────────────
# THE TWO MODEL IDS HAVE NO DEFAULT ANYWHERE IN THE CODE, and that is the
# point: a model id compiled into TypeScript is one a deployment cannot see and
# cannot change, and its wrong value is invisible — the worker keeps running and
# quietly bills a model nobody chose. With either unset, apps/server logs an
# error at boot, does NOT schedule interpretation, and does not enqueue jobs
# that would pile up in a dead-letter queue.
#
# #7's pair: a cheap default pass over every window, and a stronger tier for
# windows a deterministic text trigger fired on. Any gateway-routable id works;
# swapping providers is this line, not a code change.
INTERPRET_MODEL_DEFAULT=openai/gpt-5.6-luna
INTERPRET_MODEL_ESCALATION=anthropic/claude-sonnet-5

# #8's coalescing window, in seconds: how long a room's first unread message
# waits before the pass runs, and therefore how much of a burst one provider
# call gets to cover. A burst inside this window is ONE call.
INTERPRET_COALESCE_SECONDS=10
# How many independent workers this node runs. Rooms are independent; two
# passes over one room are prevented by the queue, not by this number.
INTERPRET_WORKER_CONCURRENCY=2
# Most messages one pass reads, and how much already-read history precedes them
# (the escalation triggers and the receipt window both read it).
INTERPRET_MAX_WINDOW_MESSAGES=50
INTERPRET_CONTEXT_MESSAGES=25
# Attempts before a pass is dead-lettered and its claims marked failed.
INTERPRET_RETRY_LIMIT=5
