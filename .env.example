# Copy to .env and adjust. Every service in docker-compose.yml reads from this
# file, and compose will not start without it — the secrets below have no
# defaults there on purpose.
#
# `pnpm infra:up` + `pnpm dev` works with these values unchanged ON A LAPTOP.
#
# POSTGRES_PASSWORD, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY below are
# DEVELOPMENT CREDENTIALS, committed to a public repository. Never deploy with
# them. On anything reachable from the internet, replace all three, and note
# that apps/server runs NODE_ENV=production there — it requires the two S3
# values explicitly rather than falling back to these.
#
# NODE_ENV=development below is what turns the fallback ON. It is an opt-in:
# an unset NODE_ENV is treated as production and the fallback does not apply.
# Values are trimmed before validation, so a stray newline is harmless and a
# whitespace-only value fails as empty.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=atrium
POSTGRES_PASSWORD=atrium
POSTGRES_DB=atrium
POSTGRES_PORT=5432

# Used by packages/db (drizzle-kit + runtime client) and apps/server (pg-boss).
# Inside compose the host is `postgres`; from the host machine it is `localhost`.
DATABASE_URL=postgres://atrium:atrium@localhost:5432/atrium

# ── Atrium server (WebSocket + pg-boss workers) ─────────────────────────────
SERVER_PORT=4000
SERVER_HOST=0.0.0.0
# Milliseconds between server->client WebSocket pings. Sockets that miss two
# consecutive pongs are terminated.
WS_HEARTBEAT_INTERVAL_MS=30000
# Concurrency for the interpret-message worker.
INTERPRET_WORKER_CONCURRENCY=2
LOG_LEVEL=info
NODE_ENV=development

# ── Web (Next.js) ───────────────────────────────────────────────────────────
WEB_PORT=3000
# The WebSocket endpoint, read AT RUNTIME by /api/runtime-config — not inlined
# into the client bundle. (It replaces NEXT_PUBLIC_WS_URL, which was: one image
# could not be promoted between environments, and an https:// page shipped a
# ws://localhost bundle that browsers refuse as mixed content.)
#
# In dev it must be set, because Next is on 3000 and the server on 4000 — not
# the same origin. In production behind a reverse proxy that forwards /ws to
# the app server, LEAVE IT UNSET: the browser derives the URL from the page's
# own origin, and wss: follows https: with nothing to get wrong.
ATRIUM_WS_URL=ws://localhost:4000/ws
# Same-origin path used when ATRIUM_WS_URL is unset. Only change this if the
# proxy forwards the socket somewhere other than /ws.
ATRIUM_WS_PATH=/ws

# ── Object storage (MinIO in dev, any S3-compatible bucket in prod) ─────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=atrium-attachments
S3_ACCESS_KEY_ID=atrium
S3_SECRET_ACCESS_KEY=atrium-dev-secret
S3_FORCE_PATH_STYLE=true
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Model access (Vercel AI SDK + AI Gateway, per issue #7) ─────────────────
# Not required to boot the scaffold; the interpret-message worker is a no-op
# until the Semantic Core interpretation pipeline lands.
AI_GATEWAY_API_KEY=
