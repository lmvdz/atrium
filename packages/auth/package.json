{
  "name": "@atrium/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Atrium authentication — one Better Auth configuration, shared by the web app and the realtime server.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@atrium/db": "workspace:*",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
